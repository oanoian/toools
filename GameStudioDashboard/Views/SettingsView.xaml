<UserControl x:Class="GameStudioDashboard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Settings form -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Studio configuration" Style="{StaticResource H2}" Margin="0,0,0,18" />

                    <TextBlock Text="STUDIO NAME" Style="{StaticResource Eyebrow}" />
                    <TextBox Text="{Binding Settings.StudioName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,18" Padding="8,6" />

                    <TextBlock Text="FRAME-RATE BUDGET TARGET" Style="{StaticResource Eyebrow}" />
                    <ComboBox ItemsSource="{Binding FpsTargets}" SelectedItem="{Binding Settings.TargetFps}"
                              Width="120" HorizontalAlignment="Left" Margin="0,6,0,18" VerticalContentAlignment="Center" />

                    <TextBlock Style="{StaticResource Eyebrow}">
                        <Run Text="TELEMETRY REFRESH INTERVAL · " /><Run Text="{Binding Settings.RefreshIntervalSeconds}" /><Run Text="s" />
                    </TextBlock>
                    <Slider Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.RefreshIntervalSeconds}" Margin="0,6,0,18" />

                    <TextBlock Style="{StaticResource Eyebrow}">
                        <Run Text="UTILIZATION ALERT THRESHOLD · " /><Run Text="{Binding Settings.UtilizationAlertPct, StringFormat={}{0:0}}" /><Run Text="%" />
                    </TextBlock>
                    <Slider Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.UtilizationAlertPct}" Margin="0,6,0,18" />

                    <TextBlock Style="{StaticResource Eyebrow}">
                        <Run Text="CRASH ALERT THRESHOLD · " /><Run Text="{Binding Settings.CrashAlertThresholdPct, StringFormat={}{0:0.0}}" /><Run Text="%" />
                    </TextBlock>
                    <Slider Minimum="0.1" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.CrashAlertThresholdPct}" Margin="0,6,0,18" />

                    <CheckBox Content="Enable live telemetry (auto-refresh)" IsChecked="{Binding Settings.LiveTelemetry}"
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10" />
                    <CheckBox Content="Compact density" IsChecked="{Binding Settings.CompactDensity}"
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,18" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save settings" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" />
                        <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" Margin="14,0,0,0"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Live render-budget preview -->
            <Border Style="{StaticResource Card}" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Render-budget preview" Style="{StaticResource H2}" />
                    <TextBlock Text="recomputed live from the FPS target above" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,4,0,18" TextWrapping="Wrap" />

                    <TextBlock Text="FRAME BUDGET" Style="{StaticResource Eyebrow}" />
                    <TextBlock Style="{StaticResource MonoLabel}" FontSize="20" Margin="0,6,0,16">
                        <Run Text="{Binding TargetMs}" /><Run Text=" ms" />
                    </TextBlock>

                    <TextBlock Text="FRAMES OVER BUDGET" Style="{StaticResource Eyebrow}" />
                    <TextBlock Style="{StaticResource MonoLabel}" FontSize="20" Margin="0,6,0,16">
                        <Run Text="{Binding PctOverBudget}" /><Run Text=" %" />
                    </TextBlock>

                    <TextBlock Text="P95 / P99 FRAME TIME" Style="{StaticResource Eyebrow}" />
                    <TextBlock Style="{StaticResource MonoLabel}" FontSize="20" Margin="0,6,0,18">
                        <Run Text="{Binding P95}" /><Run Text=" / " /><Run Text="{Binding P99}" /><Run Text=" ms" />
                    </TextBlock>

                    <TextBlock Text="COMPUTE BACKEND" Style="{StaticResource Eyebrow}" />
                    <Border Margin="0,6,0,0" CornerRadius="6" Padding="10,8"
                            Background="{DynamicResource SurfaceAltBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding NativeInactive, Converter={StaticResource RiskToBrush}}" />
                            <TextBlock Text="{Binding BackendStatus}" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
