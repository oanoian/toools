<UserControl x:Class="GameStudioDashboard.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="TaskCard">
            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Id}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding Points, StringFormat={}· {0}pt}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="advance →" FontSize="11"
                                Command="{Binding DataContext.AdvanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Padding="8,3" />
                    </Grid>
                    <TextBlock Text="{Binding Assignee}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel>

            <!-- Sprint KPI -->
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="FORECAST VELOCITY" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource Metric}" Margin="0,8,0,0">
                            <Run Text="{Binding Velocity, StringFormat={}{0:0.0}}" /><Run Text=" pts/sprint" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="SPRINT PROGRESS" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource Metric}" Margin="0,8,0,0">
                            <Run Text="{Binding DonePoints}" /><Run Text=" / " /><Run Text="{Binding CommittedPoints}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE MILESTONES" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource Metric}" Margin="0,8,0,0" Text="{Binding Milestones.Count}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Kanban -->
            <TextBlock Text="Sprint board · Aetherbound S7" Style="{StaticResource H2}" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TODO" Style="{StaticResource Eyebrow}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Todo}" ItemTemplate="{StaticResource TaskCard}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="IN PROGRESS" Style="{StaticResource Eyebrow}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding InProgress}" ItemTemplate="{StaticResource TaskCard}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="2" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="DONE" Style="{StaticResource Eyebrow}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource TaskCard}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Team workload -->
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Team workload" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Team}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Height="10" VerticalAlignment="Center" Margin="8,0">
                                            <Border HorizontalAlignment="Left" CornerRadius="4" Height="10"
                                                    Background="{Binding Load, Converter={StaticResource UtilToBrush}}"
                                                    Width="{Binding Load, Converter={StaticResource FractionToWidth}, ConverterParameter=220}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                                   Text="{Binding Load, StringFormat={}{0:P0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Milestone forecasts -->
                <Border Style="{StaticResource Card}" Grid.Column="1" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Milestone forecast (EWMA velocity)" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Milestones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0">
                                                    <Run Text="target " /><Run Text="{Binding TargetDate, StringFormat=dd MMM yyyy}" />
                                                    <Run Text="  ·  proj " /><Run Text="{Binding ProjectedText}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" CornerRadius="4" Padding="8,3"
                                                    Background="{Binding AtRisk, Converter={StaticResource RiskToBrush}}">
                                                <TextBlock Text="{Binding StatusText}" FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                                           FontWeight="Bold" Foreground="#FF07101F" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
