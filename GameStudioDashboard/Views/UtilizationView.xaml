<UserControl x:Class="GameStudioDashboard.Views.UtilizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel>

            <!-- Controls + alert -->
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Queue build job" Command="{Binding QueueJobCommand}" Style="{StaticResource AccentButton}" />
                    <Button Content="Re-balance farm" Command="{Binding RebalanceCommand}" Style="{StaticResource GhostButton}" Margin="10,0,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <TextBlock Text="{Binding Alert}" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" />
                </Border>
            </Grid>

            <!-- KPI -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="AVG CPU UTILIZATION" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource Metric}" Margin="0,8,0,0">
                            <Run Text="{Binding AvgCpu, StringFormat={}{0:0.0}}" /><Run Text="%" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="IDLE CAPACITY" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource Metric}" Margin="0,8,0,0">
                            <Run Text="{Binding IdleCapacity, StringFormat={}{0:0.0}}" /><Run Text="%" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="JOBS SCHEDULED" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource Metric}" Margin="0,8,0,0" Text="{Binding Scheduled}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="AWAITING CAPACITY" Style="{StaticResource Eyebrow}" />
                        <TextBlock Style="{StaticResource Metric}" Margin="0,8,0,0" Text="{Binding Queued}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Chart -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Per-machine utilization" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <lvc:CartesianChart Series="{Binding UtilizationSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Height="240" />
                </DockPanel>
            </Border>

            <!-- Machine list -->
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding Machines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}">
                                        <Run Text="{Binding Cores}" /><Run Text=" cores · " /><Run Text="{Binding RamGb}" /><Run Text=" GB" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="CPU" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" />
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Height="10">
                                        <Border HorizontalAlignment="Left" CornerRadius="4" Height="10"
                                                Background="{Binding CpuUtilization, Converter={StaticResource UtilToBrush}}"
                                                Width="{Binding CpuUtilization, Converter={StaticResource FractionToWidth}, ConverterParameter=260}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="RAM" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" />
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Height="10">
                                        <Border HorizontalAlignment="Left" CornerRadius="4" Height="10"
                                                Background="{Binding RamUtilization, Converter={StaticResource UtilToBrush}}"
                                                Width="{Binding RamUtilization, Converter={StaticResource FractionToWidth}, ConverterParameter=260}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Right">
                                        <Run Text="{Binding AssignedJobs}" /><Run Text=" jobs" />
                                    </TextBlock>
                                    <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Right" Text="{Binding CpuUtilization, StringFormat={}{0:P0}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
