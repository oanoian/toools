<Window x:Class="GameStudioDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameStudioDashboard.ViewModels"
        Title="Game Studio Command Center"
        Height="860" Width="1360"
        MinHeight="620" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{DynamicResource UiFont}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Nav rail item -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="tick" Width="3" Height="18" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource AccentBrush}" Opacity="0"
                                           Margin="-6,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="tick" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Nav rail ===== -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,20">
                    <TextBlock Text="COMMAND CENTER" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{Binding StudioName}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="8,4" Margin="0,12,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="project · Aetherbound" Margin="8,0,0,0" FontFamily="{DynamicResource MonoFont}"
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Today}" Margin="24,0,24,22"
                           FontFamily="{DynamicResource MonoFont}" FontSize="11"
                           Foreground="{DynamicResource MutedBrush}" />

                <ListBox ItemsSource="{Binding Views}"
                         SelectedItem="{Binding Current, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- ===== Main area ===== -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Height="72" Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Current.Title}" Style="{StaticResource H1}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="live telemetry" Margin="8,0,0,0" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Content="{Binding Current}" />
        </DockPanel>
    </Grid>
</Window>
